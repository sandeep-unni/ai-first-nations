# Copy to .env in the project root.
# Local: the docker-compose "db" service (docker compose up -d db) on port 5433.
# Railway: use the Postgres public URL with ?sslmode=require&connect_timeout=10
DATABASE_URL=postgresql://aifn:aifn_dev_password@127.0.0.1:5433/aifn_mangrove
# Without this the dashboard shows built-in demo data, not the database.
AIFN_DEMO_MODE=false
SECRET_KEY=change-me-to-a-long-random-string
# Required by docker-compose even when only starting "db".
PGADMIN_DEFAULT_PASSWORD=change-me
